# Copy to .env and adjust: cp .env.example .env
# Only the variables listed here are read by the application.

# --- Web UI -------------------------------------------------------------
# Bind address. Keep 127.0.0.1 unless the UI sits behind an authenticating
# reverse proxy: the UI itself has no login.
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7861
# Path prefix when served behind a reverse proxy, e.g. /survey
GRADIO_ROOT_PATH=

# Survey that is active at start-up (directory name under surveys/).
# Empty: the first survey found.
SURVEY_ID=

# Where the database, caches and exports go. Empty: backend/data and
# backend/outputs.
SURVEY_DATA_DIR=
SURVEY_OUTPUT_DIR=

# --- LLM (any OpenAI-compatible chat-completions endpoint) ---------------
# OpenAI:      https://api.openai.com/v1
# Local vLLM:  http://localhost:8000/v1
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=default
# Lower bound of the answer limit of every request (tasks with a higher limit of
# their own keep it). Reasoning models count their thinking against this limit:
# use 16000 or more for them, or lower their effort with LLM_EXTRA_PARAMS.
LLM_MAX_TOKENS=4096
# max_completion_tokens (OpenAI, current vLLM) or max_tokens (older servers)
LLM_MAX_TOKENS_PARAM=max_completion_tokens
# Leave empty to send no temperature at all (required by current reasoning
# models). When set, exactly this value is sent with every request.
LLM_TEMPERATURE=
# true: use the task-specific temperatures of the code instead (e.g. 0.3 for
# descriptions, rising values on retries). Only for models that accept any
# temperature; has no effect without LLM_TEMPERATURE.
LLM_TASK_TEMPERATURES=false
# JSON object merged into every request, e.g.
# {"reasoning_effort": "low"}  or  {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_PARAMS=
LLM_TIMEOUT=300
# Set to false only for self-signed certificates on a trusted network.
LLM_VERIFY_SSL=true

# --- Diagrams in generated documents ---------------------------------------
# Service that turns Mermaid diagrams into images, e.g. https://mermaid.ink/img/
# or a self-hosted instance. Empty: no external request, diagrams appear as code.
MERMAID_RENDER_URL=
